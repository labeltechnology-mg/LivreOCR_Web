# Copy to .env and fill in. Never commit .env.
# Generate a secret key:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# 0 = plain http (local test). Use 1 behind an HTTPS reverse proxy.
DJANGO_HTTPS=0
# Seconds before gunicorn kills a request: OCR of a big book can take minutes.
GUNICORN_TIMEOUT=900
# Ollama local with a smaller multimodal model. Images stay on this machine.
# From the web container to Ollama running on the Docker Desktop host.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_TIMEOUT=600
